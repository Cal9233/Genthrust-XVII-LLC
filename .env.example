# Auth (NextAuth.js)
AUTH_SECRET="generate-with-openssl-rand-hex-32"
AUTH_URL="http://localhost:3000"

# Microsoft Entra ID (Azure AD) — user-facing sign-in
AUTH_MICROSOFT_ENTRA_ID_ID="your-entra-app-client-id"
AUTH_MICROSOFT_ENTRA_ID_SECRET="your-entra-app-client-secret"
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/your-tenant-id/v2.0"
# Tenant ID used by lib/graph/index.ts for daemon token acquisition
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID="your-tenant-id-here"
# Tenant ID used by the SSO FlightDeck redirect route (must match above)
ENTRA_TENANT_ID="your-tenant-id-here"

# Microsoft Graph — daemon app (mTLS certificate auth, separate app registration)
# Used by inbox-monitor and related Trigger.dev workflows
MONITOR_APP_CLIENT_ID="your-monitor-app-client-id"
MONITOR_APP_TENANT_ID="your-tenant-id-here"
MONITOR_APP_CERT_THUMBPRINT="your-certificate-thumbprint"
# Base64-encoded PEM private key for the monitor app certificate
MONITOR_APP_CERT_PEM="base64-encoded-pem-private-key"

# Microsoft Graph — shared resources
MS_GRAPH_SHARED_MAILBOX="shared-mailbox@genthrust.net"
SHAREPOINT_SITE_ID="your-sharepoint-site-id"

# Excel / Trigger.dev workflows
EXCEL_WORKBOOK_ID="your-excel-workbook-id"
EXCEL_WORKSHEET_NAME="Active"

# Upstash Redis (rate-limiting — optional; falls back to in-memory if not set)
UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# FlightDeck SSO redirect target
FLIGHTDECK_URL="https://app.genthrust.org"

# genthrust-ai backend URL — portal API proxy target
# All /api/portal/* routes are thin proxies to this app.
# Dev: http://localhost:3001 | Prod: https://app.genthrust.org
GENTHRUST_AI_URL="https://app.genthrust.org"

# ERP AERO API
ERP_AERO_BASE_URL="https://wapi.erp.aero"
ERP_AERO_EMAIL="your-email@genthrust.net"
ERP_AERO_PASSWORD="your-erp-password"
ERP_AERO_CID="GENTHRUST"

# Main Database (genthrust)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=genthrust
DB_USER=genthrust
DB_PASSWORD=your-db-password
# Set to true in production when MySQL has TLS enabled
DB_SSL=false

# Bot Inventory Database (genthrust_inventory)
BOT_DB_HOST=localhost
BOT_DB_PORT=3306
BOT_DB_NAME=genthrust_inventory
BOT_DB_USER=genthrust_bot
BOT_DB_PASSWORD=your-bot-db-password
# Set to true in production when MySQL has TLS enabled
BOT_DB_SSL=false

***REMOVED*** (AES-256-GCM) — generate with: openssl rand -hex 32
MFA_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32

# SSO Redirect to FlightDeck (HMAC-SHA256 shared secret)
SSO_REDIRECT_SECRET=generate-with-openssl-rand-hex-32

# MCP API endpoint protection
MCP_API_KEY="generate-with-openssl-rand-hex-32"

# Resend (contact form email delivery — falls back to console.log if unset)
RESEND_API_KEY="re_your_api_key_here"

# Microsoft Teams notifications (optional; notifications are skipped if unset)
TEAMS_WORKFLOW_WEBHOOK_URL="https://your-tenant.webhook.office.com/webhookb2/..."

# Email notification CC address for RO lifecycle / overdue alerts
GENTHRUST_CC_EMAIL="ops@genthrust.net"

# Inbox monitor — comma-separated mailboxes to watch
MONITORED_MAILBOXES="inbox@genthrust.net"
# Microsoft To Do user ID for task creation from inbox monitor
TODO_USER_ID="your-microsoft-user-id"
# Healthchecks.io ping URL for inbox monitor (optional)
HEALTHCHECKS_IO_URL="https://hc-ping.com/your-check-uuid"

# Quiet hours for email notifications (24h format, e.g. "22:00" and "07:00")
QUIET_HOURS_START="22:00"
QUIET_HOURS_END="07:00"
QUIET_HOURS_TIMEZONE="America/New_York"
