# Auth (NextAuth.js)
AUTH_SECRET="generate-with-openssl-rand-hex-32"
AUTH_URL="http://localhost:3000"

# Microsoft Entra ID (Azure AD)
AUTH_MICROSOFT_ENTRA_ID_ID="your-entra-app-client-id"
AUTH_MICROSOFT_ENTRA_ID_SECRET="your-entra-app-client-secret"
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/your-tenant-id/v2.0"

# ERP AERO API
ERP_AERO_BASE_URL="https://wapi.erp.aero"
ERP_AERO_EMAIL="your-email@genthrust.net"
ERP_AERO_PASSWORD="your-erp-password"
ERP_AERO_CID="GENTHRUST"

# Main Database (genthrust)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=genthrust
DB_USER=genthrust
DB_PASSWORD=your-db-password

# Bot Inventory Database (genthrust_inventory)
BOT_DB_HOST=localhost
BOT_DB_PORT=3306
BOT_DB_NAME=genthrust_inventory
BOT_DB_USER=genthrust_bot
BOT_DB_PASSWORD=your-bot-db-password

# MFA Encryption Key (AES-256-GCM) — generate with: openssl rand -hex 32
MFA_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32
